# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=updates@kaltrixos.com

# Admin API protection (src/app/api/send-waitlist-emails)
# Required in every environment — the endpoint fails closed if this is unset.
ADMIN_SECRET_KEY=

# Paystack (payments) — public key only, used client-side in dashboard/upgrade
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
