# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_. Used by
# src/lib/supabase/service.ts for the Paystack webhook (no user session
# exists in a webhook, so it can't use the normal RLS-scoped client).
# Find it in Supabase dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=updates@kaltrixos.com

# Admin API protection (src/app/api/send-waitlist-emails)
# Required in every environment — the endpoint fails closed if this is unset.
ADMIN_SECRET_KEY=

# Paystack (payments)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Secret key — server-only. Used to verify webhook signatures and to
# re-verify transactions server-side in src/app/api/webhooks/paystack.
# Set this once you have a Paystack account, in Vercel env vars for
# production. Register the webhook URL in the Paystack dashboard under
# Settings > API Keys & Webhooks: https://yourdomain.com/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
